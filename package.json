  "keywords": [
    "openai",
    "openai-compatible",
    "llm",
    "cli",
    "api-key",
    "latency",
    "benchmark",
    "claude-code",
    "codex",
    "apimaster"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "apimaster": "bin/apimaster.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/cli.test.js",
    "lint": "node --check bin/apimaster.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apimaster-ai/apimaster-cli.git"
  },
  "homepage": "https://github.com/apimaster-ai/apimaster-cli#readme",
  "bugs": {
    "url": "https://github.com/apimaster-ai/apimaster-cli/issues"
  }
}
